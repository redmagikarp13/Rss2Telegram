# Token do bot do Telegram (obtido via @BotFather)
BOT_TOKEN=seu_token_aqui

# ID do chat/grupo/canal onde enviar as notificações
# Para descobrir: envie uma mensagem pro bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
CHAT_ID=seu_chat_id_aqui

# (Opcional) Rodar sem enviar mensagens, só mostrar no terminal
# DRYRUN=true

# (Opcional) Primeira execução silenciosa — registra editais existentes sem notificar
# FIRST_RUN_SILENT=true

# ──────────────────────────────────────────────────────────
# ATENÇÃO: este projeto NÃO lê arquivo .env (não há python-dotenv).
# src/config.py só enxerga variável de ambiente real ou um arquivo
# homônimo .txt na raiz (padrão de BOT_TOKEN.txt / DESTINATION.txt).
# Copie para o ambiente (`export EDITAL_MAX_DIAS=90`) ou crie os .txt.
# No servidor de produção (GitHub Actions) o valor é definido como
# Variable do repositório — ver .github/workflows/scraper.yml.
# ──────────────────────────────────────────────────────────

# (Opcional) Janela de dias — só notifica editais publicados nos últimos N dias.
# 0 = desativado (aceita qualquer data, inclusive editais de 2020).
# A data sai do feed/listagem quando existe; senão do ano do identificador no
# título ('Edital 12/2020' conta como 31/12/2020 e cai fora da janela).
# Recomendado: 90.
# EDITAL_MAX_DIAS=90

# (Opcional) Limite máximo de editais por fonte por execução, mantendo os mais
# recentes. Essencial para as fontes que entregam o arquivo histórico inteiro
# por uma única URL (Proex 514, Agifes 430, FACTO 160).
# 0 = sem limite. Recomendado: 10.
# MAX_ITENS_POR_FONTE=10

# (Opcional) Teto agregado: maximo de notificacoes por ESTADO por execucao,
# mantendo as mais recentes. O teto por fonte e individual e nao limita o total
# do chat (51 fontes x 10 ainda somariam centenas de mensagens).
# Agrupamento definido em src/config.py::SITE_ESTADOS.
# 0 = desativado. Recomendado: 20.
# MAX_ITENS_POR_ESTADO=20

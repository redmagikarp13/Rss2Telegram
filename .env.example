# Token do bot do Telegram (obtido via @BotFather)
BOT_TOKEN=seu_token_aqui

# ID do chat/grupo/canal onde enviar as notificações
# Para descobrir: envie uma mensagem pro bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
CHAT_ID=seu_chat_id_aqui

# (Opcional) Rodar sem enviar mensagens, só mostrar no terminal
# DRYRUN=true

# (Opcional) Primeira execução silenciosa — registra editais existentes sem notificar
# FIRST_RUN_SILENT=true

# (Opcional) Janela de dias — só notifica editais com data nos últimos N dias.
# 0 = desativado (aceita qualquer data). Recomendado: 30 ou 60.
# EDITAL_MAX_DIAS=0

# (Opcional) Limite máximo de editais por fonte por execução.
# 0 = sem limite. Recomendado: 10 ou 15 para evitar flood.
# MAX_ITENS_POR_FONTE=0
